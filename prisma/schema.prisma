datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum UserRole {
  PATIENT
  DOCTOR
  ADMIN
}

enum ApptStatus {
  PENDING
  CONFIRMED
  CANCELLED
  COMPLETED
}

enum PaymentStatus {
  UNPAID
  PAID
  REFUNDED
}

enum QueueStatus {
  NOT_ARRIVED
  WAITING
  ACTIVE
  SKIPPED
  COMPLETED
}

model User {
  id            String             @id @default(uuid())
  name          String
  email         String             @unique
  phone         String?
  role          UserRole           @default(PATIENT)
  passwordHash  String
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt
  
  // Relations
  doctorProfile Doctor?
  appointments  Appointment[]      @relation("PatientAppointments")
  reports       MedicalReport[]
  reminders     MedicineReminder[]
  familyMembers FamilyMember[]     @relation("UserFamilyMembers")
  healthProfile HealthProfile?
}

model Doctor {
  id              String        @id
  user            User          @relation(fields: [id], references: [id], onDelete: Cascade)
  specialization  String
  experience      Int
  consultationFee Float
  availability    Json          // Structured availability schedule
  qualifications  String[]
  languages       String[]
  rating          Float         @default(5.0)
  
  // Relations
  appointments    Appointment[]
}

model FamilyMember {
  id          String        @id @default(uuid())
  parentId    String
  parent      User          @relation("UserFamilyMembers", fields: [parentId], references: [id], onDelete: Cascade)
  name        String
  relation    String        // "FATHER", "MOTHER", "CHILD", "GRANDPARENT", "SPOUSE"
  age         Int
  gender      String
  createdAt   DateTime      @default(now())
  
  // Relations
  appointments Appointment[]
}

model Appointment {
  id             String        @id @default(uuid())
  patientId      String
  patient        User          @relation("PatientAppointments", fields: [patientId], references: [id])
  familyMemberId String?
  familyMember   FamilyMember? @relation(fields: [familyMemberId], references: [id], onDelete: SetNull)
  doctorId       String
  doctor         Doctor        @relation(fields: [doctorId], references: [id])
  date           DateTime
  timeSlot       String
  status         ApptStatus    @default(PENDING)
  paymentStatus  PaymentStatus @default(UNPAID)
  paymentId      String?
  tokenNumber    Int?
  queueStatus    QueueStatus   @default(NOT_ARRIVED)
  createdAt      DateTime      @default(now())

  // Relations
  prescription   Prescription?
}

model Prescription {
  id            String      @id @default(uuid())
  appointmentId String      @unique
  appointment   Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  medicines     Json        // Array of { name: String, dosage: String, frequency: String, duration: String }
  notes         String?
  createdAt     DateTime    @default(now())
}

model MedicalReport {
  id            String   @id @default(uuid())
  patientId     String
  patient       User     @relation(fields: [patientId], references: [id], onDelete: Cascade)
  fileUrl       String
  fileName      String
  reportType    String   // LAB_RESULT, IMAGING, GENERAL
  riskLevel     String   @default("LOW") // LOW, MEDIUM, HIGH
  keyFindings   String?  // Summary text
  abnormalValues String? // Comma-separated or text of alerts
  createdAt     DateTime @default(now())
}

model MedicineReminder {
  id        String   @id @default(uuid())
  patientId String
  patient   User     @relation(fields: [patientId], references: [id], onDelete: Cascade)
  medicine  String
  time      String
  active    Boolean  @default(true)
}

model HealthProfile {
  id                     String   @id @default(uuid())
  patientId              String   @unique
  patient                User     @relation(fields: [patientId], references: [id], onDelete: Cascade)
  bloodSugar             Int      // mg/dL
  systolicBP             Int      // mmHg
  exerciseHoursPerWeek   Int
  smoking                Boolean
  heartRisk              Int      // calculated risk percentage (0-100)
  diabetesRisk           Int      // calculated risk percentage (0-100)
  bmiRisk                Int      // calculated risk percentage (0-100)
  lifestyleScore         Int      // score (0-100)
  updatedAt              DateTime @updatedAt
}

model MedicineInventory {
  id         String   @id @default(uuid())
  name       String
  quantity   Int
  expiryDate DateTime
  supplier   String
  createdAt  DateTime @default(now())
}
